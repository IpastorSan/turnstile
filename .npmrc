# The Hedera SDK (@hiero-ledger/cryptography) depends on react-native-get-random-values,
# which declares a NON-optional peer on react-native. We are a Node server project and
# never import React Native, but npm 11 tries to auto-install that peer — so the lockfile
# and `npm ci` disagree about whether react-native belongs in the tree, and CI fails with
# "Missing: react-native@0.87.1 from lock file".
#
# Setting this here rather than as a CI flag means local installs and CI resolve the same
# way. A CI-only flag would leave the lockfile being written under different rules than it
# is verified under, which is what broke in the first place.
legacy-peer-deps=true
