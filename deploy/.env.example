# Copy to deploy/.env. Only deployment shape lives here; every credential comes
# from the repo-root .env, which compose reads directly.

# Local (the default if this file is absent):
TURNSTILE_SITE_ADDRESS=http://localhost

# Live. A bare hostname makes Caddy request a real certificate, so only set this
# once the A record actually points at the box, or issuance will fail and retry.
# TURNSTILE_SITE_ADDRESS=turnstile.moveseventyeight.com
