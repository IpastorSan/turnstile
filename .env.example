# Turnstile — environment template
# Copy to .env and fill in. .env is gitignored and must stay that way.
# These get sealed with the Ledger Key Ring (MOV-224); see docs/ledger-keyring.md.

export CARGO_TARGET_DIR="$HOME/.cache/turnstile-target"  # shared Rust build cache across worktrees
export GRAPH_DEPLOY_KEY=""
export GRAPH_GATEWAY_API_KEY=""
export SUBSTREAMS_API_TOKEN=""
export CRE_API_KEY=""
export HEDERA_OPERATOR_ID=""
export HEDERA_OPERATOR_KEY=""             # raw 64-hex ECDSA, NOT the DER form the portal also shows
# MOV-220. `node scripts/hedera-setup.ts` creates the buyer account and the
# receipt topic and prints these four lines. The buyer needs an account of its
# own: a transfer from the payout account to itself nets to zero and the
# facilitator rejects it.
export HEDERA_PAYOUT_ACCOUNT=""           # seller payout, `0.0.x`. Defaults to HEDERA_OPERATOR_ID
export HEDERA_BUYER_ID=""                 # buyer agent hot wallet, `0.0.x`
export HEDERA_BUYER_KEY=""                # raw 64-hex ECDSA. Spends within a mandate; authorizes nothing
export HEDERA_RECEIPT_TOPIC_ID=""         # HCS settlement receipts, `0.0.x`
export BLOCKY402_URL="https://api.testnet.blocky402.com"   # no API key on testnet, verified 2026-09-07
# export HEDERA_HBAR_USD=""               # optional: pin the rate instead of reading the network exchange rate
export CIRCLE_API_KEY=""
export PRIVY_APP_ID=""
export PRIVY_APP_SECRET=""
export WORLD_APP_ID=""
export WORLD_SANDBOX_KEY=""
export SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"  # public node works; an Alchemy/Infura key is faster
export ETHERSCAN_API_KEY=""
export DEPLOYER_PRIVATE_KEY="0x..."  # MUST carry the 0x prefix — vm.envUint rejects it otherwise, even though cast accepts it
