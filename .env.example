# Turnstile — environment template
# Copy to .env and fill in. .env is gitignored and must stay that way.
# These get sealed with the Ledger Key Ring (MOV-224); see docs/ledger-keyring.md.

export CARGO_TARGET_DIR="$HOME/.cache/turnstile-target"  # shared Rust build cache across worktrees
export GRAPH_DEPLOY_KEY=""
export GRAPH_GATEWAY_API_KEY=""
export SUBSTREAMS_API_TOKEN=""
# Correction (2026-09-07, MOV-227): leave CRE_API_KEY UNSET unless you have a
# real one from app.chain.link. The `cre` CLI prefers it over the credentials
# `cre login` writes to ~/.cre/cre.yaml, so a wrong or stale value breaks every
# command with `unauthorized: invalid token` — including `cre workflow
# simulate`, which needs no account privileges at all. Log in instead.
# export CRE_API_KEY=""
export HEDERA_OPERATOR_ID=""
export HEDERA_OPERATOR_KEY=""
export CIRCLE_API_KEY=""
export PRIVY_APP_ID=""
export PRIVY_APP_SECRET=""
export WORLD_APP_ID=""
export WORLD_SANDBOX_KEY=""
export SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"  # public node works; an Alchemy/Infura key is faster
export ETHERSCAN_API_KEY=""
export DEPLOYER_PRIVATE_KEY="0x..."  # MUST carry the 0x prefix — vm.envUint rejects it otherwise, even though cast accepts it

# --- MOV-227: Chainlink CRE confidential workflow ---
# Released by the Vault DON into the attested enclave, mapped in
# seller/cre/secrets.yaml. Neither is ever logged, and neither crosses
# usingTheDons().
export TURNSTILE_EVIDENCE_TOKEN=""   # bearer token gating seller/cre/evidence-server.ts
export TURNSTILE_CALIBRATION=''      # JSON threshold overrides — THE METHOD. In production this exists only inside the enclave.
