# Turnstile — environment template
# Copy to .env and fill in. .env is gitignored and must stay that way.
# Correction (2026-09-08, MOV-000): this line used to read "These get sealed with
# the Ledger Key Ring (MOV-224); see docs/ledger-keyring.md." Both halves were
# wrong: the Ledger track is not pursued (wallet-cli ring init fails on our only
# device, a Nano S, which LKRP has never supported), and docs/ledger-keyring.md
# was never written, so that link has always dangled. Nothing seals these values
# today — keep .env out of git and treat every value here as a live secret.

export CARGO_TARGET_DIR="$HOME/.cache/turnstile-target"  # shared Rust build cache across worktrees
export GRAPH_DEPLOY_KEY=""
export GRAPH_GATEWAY_API_KEY=""
export SUBSTREAMS_API_TOKEN=""
# Correction (2026-09-07, MOV-227): leave CRE_API_KEY UNSET unless you have a
# real one from app.chain.link. The `cre` CLI prefers it over the credentials
# `cre login` writes to ~/.cre/cre.yaml, so a wrong or stale value breaks every
# command with `unauthorized: invalid token` — including `cre workflow
# simulate`, which needs no account privileges at all. Log in instead.
# export CRE_API_KEY=""
export HEDERA_OPERATOR_ID=""
export HEDERA_OPERATOR_KEY=""             # raw 64-hex ECDSA, NOT the DER form the portal also shows
# MOV-220. `node scripts/hedera-setup.ts` creates the buyer account and the
# receipt topic and prints these four lines. The buyer needs an account of its
# own: a transfer from the payout account to itself nets to zero and the
# facilitator rejects it.
export HEDERA_PAYOUT_ACCOUNT=""           # seller payout, `0.0.x`. Defaults to HEDERA_OPERATOR_ID
export HEDERA_BUYER_ID=""                 # buyer agent hot wallet, `0.0.x`
export HEDERA_BUYER_KEY=""                # raw 64-hex ECDSA. Spends within a mandate; authorizes nothing
export HEDERA_RECEIPT_TOPIC_ID=""         # HCS settlement receipts, `0.0.x`
export BLOCKY402_URL="https://api.testnet.blocky402.com"   # no API key on testnet, verified 2026-09-07
# export HEDERA_HBAR_USD=""               # optional: pin the rate instead of reading the network exchange rate
export CIRCLE_API_KEY=""
export PRIVY_APP_ID=""
export PRIVY_APP_SECRET=""
#
# The rest of the Privy block is created by `npm run privy:setup`, which prints
# it ready to paste. Run it once — every call creates NEW objects, so rerunning
# makes a second organization and orphans the first.
#
# The two operator keys are base64 PKCS#8 P-256 secrets. They are the approval
# keys: PRIVY_APP_SECRET alone cannot raise the mandate cap, and that is the
# point. In production each one belongs on its operator's own device, not here.
export PRIVY_OPERATOR_ALICE_KEY=""       # alice, CFO
export PRIVY_OPERATOR_ALICE_USER_ID=""
export PRIVY_OPERATOR_ALICE_WALLET=""    # her Privy embedded wallet
export PRIVY_OPERATOR_BOB_KEY=""         # bob, Head of Research
export PRIVY_OPERATOR_BOB_USER_ID=""
export PRIVY_OPERATOR_BOB_WALLET=""
export PRIVY_OPS_QUORUM_ID=""            # 1 of 2 — owns the org wallet
export PRIVY_BOARD_QUORUM_ID=""          # 2 of 2 — owns the mandate policy
export PRIVY_MANDATE_POLICY_ID=""        # raising its cap needs the board quorum
export PRIVY_ORG_WALLET_ID=""            # the warm tier
export PRIVY_ORG_WALLET_ADDRESS=""
export WORLD_APP_ID=""                   # Developer Portal → your app, `app_…`
export WORLD_RP_ID=""                    # same page, `rp_…`. A PATH SEGMENT on the verify URL, not a header
export WORLD_RP_SIGNING_KEY=""           # same page → signing key. Backend only; it must never reach a browser
export SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"  # public node works; an Alchemy/Infura key is faster
export ETHERSCAN_API_KEY=""
export DEPLOYER_PRIVATE_KEY="0x..."  # MUST carry the 0x prefix — vm.envUint rejects it otherwise, even though cast accepts it

# --- MOV-227: Chainlink CRE confidential workflow ---
# Released by the Vault DON into the attested enclave, mapped in
# seller/cre/secrets.yaml. Neither is ever logged, and neither crosses
# usingTheDons().
export TURNSTILE_EVIDENCE_TOKEN=""   # bearer token gating seller/cre/evidence-server.ts
export TURNSTILE_CALIBRATION=''      # JSON threshold overrides — THE METHOD. In production this exists only inside the enclave.

# --- MOV-225: Arc rail, Circle Gateway Nanopayments ---
# Two keys, and the split between them is the whole zero-gas property.
#
# `node scripts/arc-setup.ts` funds the agent's Gateway balance and prints both
# wallets' nonce and balances. Get testnet USDC for the ORG address from
# https://faucet.circle.com (pick Arc Testnet) — the faucet is reCAPTCHA-gated,
# so it needs a human, and our CIRCLE_API_KEY does not carry the faucet scope.
#
# The ORG wallet is the warm tier: it holds the USDC, calls depositFor() to move
# it into the agent's Gateway balance, and pays that transaction's gas.
#
# Correction (2026-09-07, MOV-228): the warm tier is no longer these variables.
# It is the Privy org wallet above (PRIVY_ORG_WALLET_*), which has no private key
# outside Privy's enclave. ARC_ORG_PRIVATE_KEY is read for exactly one thing —
# `node scripts/arc-setup.ts --seed 2`, the one-time transfer that moves testnet
# USDC to the new org wallet, because Circle's faucet is reCAPTCHA-gated and a
# fresh address cannot fund itself. Leave it unset if you have no legacy key;
# fund PRIVY_ORG_WALLET_ADDRESS from the faucet instead.
export ARC_ORG_PRIVATE_KEY="0x..."        # LEGACY. Only `arc-setup.ts --seed` reads it
export ARC_ORG_ADDRESS="0x..."            # LEGACY
# The AGENT wallet is the hot tier. It signs EIP-3009 authorizations offchain and
# NEVER submits a transaction, so it pays exactly zero gas and its nonce stays 0.
# Sending anything from this key destroys the proof — do not fund it directly.
export ARC_AGENT_PRIVATE_KEY="0x..."      # hot tier. Spends within a mandate; authorizes nothing
export ARC_AGENT_ADDRESS="0x..."
export ARC_PAYOUT_ADDRESS="0x0Adca6e14bA956201D221feC767e4f24194bf5F2"  # addr(60) on liquidity.turnstile.eth
# export ARC_FACILITATOR_URL="https://gateway-api-testnet.circle.com"   # no API key, verified 2026-09-07.
#                                                                       # The SDK defaults to MAINNET, so the rail passes this explicitly.
# export ARC_RPC_URL="https://rpc.testnet.arc.network"                  # public, no key
